<local:EditorSurface x:Class="FileOrganizer.Configurator.Views.ClassicView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FileOrganizer.Configurator"
 FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <local:EditorSurface.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></local:EditorSurface.Resources>
 <DockPanel Margin="12" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel>
    <Button Content="New" Command="{Binding NewCommand}"/>
    <Button Content="Open…" Command="{Binding OpenCommand}"/>
    <Button Content="Save" Command="{Binding SaveCommand}"/>
    <Button Content="Save As…" Command="{Binding SaveAsCommand}"/>
    <Button Content="Reload" Command="{Binding ReloadCommand}"/>
    <Button Content="Validate" Command="{Binding ValidateCommand}"/>
    <Button Content="Avvia scansione" Command="{Binding StartScanCommand}" ToolTip="Disponibile a motore fermo. Se la bozza è modificata, chiede di salvarla prima di avviare."/>
    <Button Content="Arresta scansione" Command="{Binding StopScanCommand}" ToolTip="Richiede un arresto sicuro della scansione o del motore in background."/>
    <Button Content="Cancel undo" Command="{Binding CancelUndoCommand}"/>
   </WrapPanel>
   <TextBox Text="{Binding ConfigPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"/>
   <TextBlock Text="{Binding ExternalMessage}" Foreground="DarkRed" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding SyncMessage}" Foreground="DarkRed" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4"/>
   <TextBlock Text="{Binding RuntimeWarning}" Foreground="DarkRed" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <Expander Header="Current file values and applied engine state" IsExpanded="True">
    <StackPanel><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding SavedSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding RuntimeMessage}" TextWrapping="Wrap" Margin="0,4"/></StackPanel></ScrollViewer>
     <WrapPanel><Button Content="Verify state" Command="{Binding CheckSyncCommand}"/><Button Content="Open engine's TOML" Command="{Binding OpenEngineConfigCommand}"/></WrapPanel>
    </StackPanel>
   </Expander>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Padding="6" Margin="0,8,0,0">
   <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="38" MaxHeight="100"/>
  </Border>
  <TabControl x:Name="MainTabs" SelectionChanged="OnTabChanged" IsEnabled="{Binding IsInteractive}">
   <TabItem Header="Folders and rules" Tag="Folders">
    <Grid Margin="8" IsEnabled="{Binding CanEditForm}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <TextBlock Text="Monitored folders" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <WrapPanel><Button Content="Add" Command="{Binding AddFolderCommand}"/><Button Content="Remove" Command="{Binding RemoveFolderCommand}"/></WrapPanel>
       <WrapPanel><Button Content="↑ Up" Command="{Binding FolderUpCommand}"/><Button Content="↓ Down" Command="{Binding FolderDownCommand}"/></WrapPanel>
      </StackPanel>
      <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" HorizontalContentAlignment="Stretch">
       <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3"><CheckBox IsChecked="{Binding Fields[enabled].Flag}" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding HasFolder}">
      <StackPanel>
       <GroupBox Header="Folder — draft until Save">
        <StackPanel>
         <TextBlock Text="Name"/><TextBox Text="{Binding SelectedFolder.Fields[name].Text, UpdateSourceTrigger=PropertyChanged}"/>
         <TextBlock Text="Source path (environment variables supported)"/>
         <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSourceCommand}" Margin="6,2,0,7"/><TextBox Text="{Binding SelectedFolder.Fields[path].Text, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
         <WrapPanel><CheckBox Content="Enabled" IsChecked="{Binding SelectedFolder.Fields[enabled].Flag}"/><CheckBox Content="Include subfolders (default; path selections take precedence)" IsChecked="{Binding SelectedFolder.Fields[recursive].Flag}"/></WrapPanel>
         <TextBlock Text="Include subfolders applies to source AND destinations. When off, only direct files in each configured path are checked. Use Managed paths for individual branch selections. Saving can reclassify existing files." TextWrapping="Wrap" Foreground="DimGray"/>
         <Expander Header="Resolved paths and exclusions" Margin="0,6,0,0"><TextBlock Text="{Binding ResolvedPaths}" TextWrapping="Wrap" Margin="4"/></Expander>
        </StackPanel>
       </GroupBox>
       <GroupBox Header="Duplicate handling (this folder)">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Different content, same name"/><ComboBox ItemsSource="{x:Static local:EditorViewModel.NamePolicies}" SelectedItem="{Binding SelectedFolder.Fields[duplicates.name_collision].Text}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Identical content"/><ComboBox ItemsSource="{x:Static local:EditorViewModel.ContentPolicies}" SelectedItem="{Binding SelectedFolder.Fields[duplicates.identical_content].Text}"/><TextBlock Text="delete removes the verified original" Foreground="DarkRed" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Grid.Column="4"><TextBlock Text="Copy suffix (one {n})"/><TextBox Text="{Binding SelectedFolder.Fields[duplicates.copy_suffix].Text, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </Grid>
       </GroupBox>
       <GroupBox Header="Rules — first enabled match wins">
        <StackPanel>
         <WrapPanel>
          <ComboBox ItemsSource="{x:Static local:EditorViewModel.RulePresets}" SelectedItem="{Binding SelectedRulePreset}" DisplayMemberPath="Name" Width="150" Height="28" Margin="0,0,6,4" AutomationProperties.Name="Rule template">
           <ComboBox.ToolTip><TextBlock Text="{Binding SelectedRulePreset.Description}" MaxWidth="440" TextWrapping="Wrap"/></ComboBox.ToolTip>
          </ComboBox>
          <Button Content="Add" Command="{Binding AddRuleCommand}"/><Button Content="Duplicate" Command="{Binding DuplicateRuleCommand}"/><Button Content="Remove" Command="{Binding RemoveRuleCommand}"/><Button Content="↑ Up" Command="{Binding RuleUpCommand}"/><Button Content="↓ Down" Command="{Binding RuleDownCommand}"/>
         </WrapPanel>
         <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" MaxHeight="135" MinHeight="70">
          <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2"><CheckBox IsChecked="{Binding Fields[enabled].Flag}" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayName}"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <StackPanel IsEnabled="{Binding HasRule}" Margin="0,8,0,0">
          <TextBlock Text="Rule name"/><TextBox Text="{Binding SelectedRule.Fields[name].Text, UpdateSourceTrigger=PropertyChanged}"/>
          <WrapPanel><CheckBox Content="Enabled" IsChecked="{Binding SelectedRule.Fields[enabled].Flag}"/><CheckBox Content="Case sensitive" IsChecked="{Binding SelectedRule.Fields[case_sensitive].Flag}"/></WrapPanel>
          <TextBlock Text="Destination (absolute, or relative to the source)"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseDestinationCommand}" Margin="6,2,0,7"/><TextBox Text="{Binding SelectedRule.Fields[destination].Text, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="Extensions — one per line"/><TextBox Text="{Binding SelectedRule.Fields[extensions].Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="82"/></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="Glob patterns — one per line"/><TextBox Text="{Binding SelectedRule.Fields[patterns].Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="82"/></StackPanel>
           <StackPanel Grid.Column="4"><TextBlock Text="Exclusions — one per line"/><TextBox Text="{Binding SelectedRule.Fields[exclude_patterns].Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="82"/></StackPanel>
          </Grid>
          <TextBlock Text="Extensions AND patterns when both are filled. Entries within each list use OR. Any matching exclusion vetoes the rule. * = any characters; ? = one character." TextWrapping="Wrap" Foreground="DimGray"/>
         </StackPanel>
        </StackPanel>
       </GroupBox>
       <GroupBox Header="Filename preview — no file operations">
        <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Preview" Command="{Binding PreviewCommand}" Margin="6,2,0,7"/><TextBox Text="{Binding PreviewName, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Text="{Binding PreviewResult}" TextWrapping="Wrap"/></StackPanel>
       </GroupBox>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="General and Windows startup" Tag="General">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
     <StackPanel>
      <GroupBox Header="General settings" IsEnabled="{Binding CanEditForm}">
       <StackPanel>
        <WrapPanel><CheckBox Content="Scan on engine startup" IsChecked="{Binding Document.General.Fields[scan_on_startup].Flag}"/><CheckBox Content="Watch configuration changes" IsChecked="{Binding Document.General.Fields[watch_config_changes].Flag}"/><CheckBox Content="Dry run (no file moves)" IsChecked="{Binding Document.General.Fields[dry_run].Flag}"/></WrapPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Log level"/><ComboBox ItemsSource="{x:Static local:EditorViewModel.LogLevels}" SelectedItem="{Binding Document.General.Fields[log_level].Text}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Readiness timeout (1–86400 seconds)"/><TextBox Text="{Binding Document.General.Fields[file_ready_timeout_seconds].Text, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         <StackPanel Grid.Column="4"><TextBlock Text="Maximum parallel moves (1–16)"/><TextBox Text="{Binding Document.General.Fields[max_parallel_moves].Text, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </Grid>
        <TextBlock Text="Saving can cause a running engine to reload and reconcile immediately. With configuration watching disabled, restart the engine to apply changes." TextWrapping="Wrap" Foreground="DimGray"/>
       </StackPanel>
      </GroupBox>
      <GroupBox Header="Background engine at Windows login">
       <StackPanel>
        <TextBlock Text="Published engine executable (FileOrganizer.exe)"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseEngineCommand}" Margin="6,2,0,7"/><TextBox Text="{Binding EnginePath, UpdateSourceTrigger=LostFocus}"/></DockPanel>
        <WrapPanel><CheckBox x:Name="StartupToggle" Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=OneWay}" IsThreeState="True" IsEnabled="{Binding CanManageStartup}" Click="OnStartupClick"/><Button Content="Refresh status" Command="{Binding RefreshStartupCommand}"/></WrapPanel>
        <TextBox Text="{Binding StartupMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"/>
        <TextBlock Text="This changes the selected configuration's actual HKCU autorun entry for the engine. It does not launch or register the GUI. A shaded toggle indicates a mismatched or unreadable entry; see the status above. Windows policy or Task Manager may independently prevent login startup." TextWrapping="Wrap" Foreground="DimGray"/>
       </StackPanel>
      </GroupBox>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="TOML" Tag="Toml">
    <DockPanel Margin="10">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Original properties, comments and raw paths are preserved. Apply TOML updates the form; Save performs engine validation. Unsupported properties remain visible and are never discarded." TextWrapping="Wrap" Margin="0,0,0,8"/>
      <WrapPanel><Button Content="Apply TOML to form" Command="{Binding ApplyRawCommand}"/><Button Content="Refresh from form / discard unapplied text" Command="{Binding RefreshRawCommand}"/></WrapPanel>
     </StackPanel>
     <TextBox x:Name="TomlEditor" Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="Managed paths" Tag="Paths">
    <DockPanel Margin="10">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="□ Excluded (gray; children hidden)     ■ Partially included branch     ✓ Complete branch / no subfolders" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock Text="Left: □ → ■ → ✓ → □. Right: □ → ✓ → ■ → □. Without subfolders: □ ↔ ✓ with either click. Each path appears once; configured paths are connected automatically. Intermediate containers can have excluded direct files: see tooltips. Save to apply. Disabled monitors must first be enabled in Folders and rules." TextWrapping="Wrap" Margin="0,5"/>
      <WrapPanel><ComboBox ItemsSource="{x:Static local:EditorViewModel.PathViews}" SelectedItem="{Binding PathView}" Width="160"/><Button Content="Load / refresh paths" Command="{Binding LoadPathsCommand}"/></WrapPanel>
      <TextBlock Text="{Binding TreeStatus}" TextWrapping="Wrap" Margin="0,4,0,8"/>
     </StackPanel>
     <TreeView ItemsSource="{Binding PathRoots}" Tag="{Binding CanEditTree}" TreeViewItem.Expanded="OnPathExpanded" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <TreeView.Resources><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/><Style.Triggers><DataTrigger Binding="{Binding IsOff}" Value="True"><Setter Property="Foreground" Value="Gray"/></DataTrigger></Style.Triggers></Style></TreeView.Resources>
      <TreeView.ItemTemplate>
       <HierarchicalDataTemplate ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
         <Button Content="{Binding Symbol}" Width="32" Padding="2" Margin="0,1,6,1" FontSize="16" Click="OnPathLeftClick" PreviewMouseRightButtonUp="OnPathRightClick" AutomationProperties.Name="{Binding Label}">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="IsEnabled" Value="{Binding CanCycle}"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
         </Button>
         <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
        </StackPanel>
       </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
     </TreeView>
    </DockPanel>
   </TabItem>
   <TabItem Header="History" Tag="History">
    <DockPanel Margin="10">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Recorded moves from the last seven days for the open TOML. Undo checks identity and content, never overwrites files, and leaves the engine stopped. Older moves and duplicate deletions cannot be undone here." TextWrapping="Wrap"/>
      <CheckBox Content="Show all configurations (including renamed or deleted TOML files)" IsChecked="{Binding ShowAllHistory}" Margin="0,6"/>
      <WrapPanel><Button Content="Refresh history" Command="{Binding RefreshHistoryCommand}"/><Button Content="Undo selected" Command="{Binding UndoHistoryCommand}"/><Button Content="Stop engine safely" Command="{Binding StopWorkerCommand}"/></WrapPanel>
      <TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap" Margin="0,5"/>
     </StackPanel>
     <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding HistoryEntries}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnHistorySelectionChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150"/>
       <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
       <DataGridTextColumn Header="Original path" Binding="{Binding Source}" Width="*"/>
       <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
       <DataGridTextColumn Header="Bytes" Binding="{Binding Size}" Width="90"/>
       <DataGridTextColumn Header="TOML" Binding="{Binding ConfigPath}" Width="160"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</local:EditorSurface>
