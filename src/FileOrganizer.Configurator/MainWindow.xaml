<Window x:Class="FileOrganizer.Configurator.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Icon="Assets/FileOrganizer.ico" Width="1160" Height="820" MinWidth="920" MinHeight="680"
 WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary Source="Views/InterfaceIcons.xaml"/></Window.Resources>
 <Window.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
 </Window.InputBindings>
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="12,5" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
   <DockPanel>
    <Button x:Name="InterfaceSwitch" DockPanel.Dock="Left" Click="OnInterfaceSwitch" Width="32" Height="32" Padding="5" Margin="0,0,8,0" VerticalAlignment="Center">
     <Image x:Name="InterfaceIcon" Width="20" Height="20" Stretch="Uniform"/>
    </Button>
    <TextBlock x:Name="InterfaceLabel" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="PreferenceWarning" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Margin="16,0" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <ContentControl x:Name="SurfaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </DockPanel>
</Window>
